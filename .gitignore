__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.tox/
.cache/
.coverage
coverage.xml
nosetests.xml
pip-log.txt
pip-delete-this-directory.txt
.hypothesis/

# =========================
# Jupyter
# =========================
.ipynb_checkpoints/

# =========================
# Streamlit
# =========================
.streamlit/secrets.toml

# =========================
# LARGE EMBEDDING FILES
# =========================

# Ignore ONLY huge embedding training files
embeddings/trained/

# Ignore huge binary formats
*.npy
*.bin

# Ignore heavy gensim models
*.model

# =========================
# KEEP TRAINED PKL CLASSIFIERS
# =========================

# IMPORTANT:
# Do NOT ignore models/trained completely
# because prediction needs classifier PKLs

# Ignore only heavy files inside trained models
models/trained/*.model
models/trained/*.npy
models/trained/*.bin

# Keep classifier PKLs
!models/trained/*.pkl

# =========================
# KEEP VECTORIZERS
# =========================

!embeddings/vectorizers/*.pkl

# =========================
# KEEP RESULTS
# =========================

!outputs/results/*.csv

# =========================
# KEEP FIGURES
# =========================

!outputs/figures/**/*.png

# =========================
# Outputs
# =========================
logs/

# =========================
# Raw Data
# =========================

# Optional
# data/raw/*

!data/raw/.gitkeep

# =========================
# Temporary / Cache
# =========================
*.tmp
*.temp

# =========================
# OS Files
# =========================
.DS_Store
Thumbs.db