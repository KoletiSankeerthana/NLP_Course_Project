# =========================
# Large ML Artifacts
# =========================

# Ignore heavy trained embedding models
embeddings/trained/

# Ignore huge trained classifiers
models/trained/

# Ignore huge binary model formats
*.model
*.npy
*.bin

# Ignore cache model artifacts
*.pickle
*.joblib

# =========================
# KEEP REQUIRED DEPLOYMENT FILES
# =========================

# Keep vectorizers
!embeddings/vectorizers/*.pkl

# Keep lightweight trained classifier PKLs if needed
!models/trained/*.pkl

# Keep evaluation results
!outputs/results/*.csv

# Keep figures/images
!outputs/figures/**/*.png

# =========================
# Outputs
# =========================
logs/

# =========================
# Raw Data
# =========================

# Optional: ignore huge raw datasets
# data/raw/*

# Keep gitkeep
!data/raw/.gitkeep

# =========================
# Temporary / Cache
# =========================
*.tmp
*.temp

# =========================
# OS Files
# =========================
.DS_Store
Thumbs.db